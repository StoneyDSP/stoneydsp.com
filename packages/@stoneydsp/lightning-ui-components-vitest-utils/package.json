{
	"name": "@stoneydsp/ui-components-vitest-utils",
	"version": "1.6.0",
	"description": "Helpful Vitest unit test utilities for LightningJS applications utilizing the Lightning 2 SDK package.",
	"repository": {
		"url": "https://github.com/nathanjhood/lightningjs-vitest-utils"
	},
	"homepage": "https://rdkcentral.github.io/Lightning-UI-Components/",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"@lightningjs/core": "2.15.0",
		"@lightningjs/sdk": "5.5.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"vite": "^7.2.7",
		"vitest": "^4.0.15",
		"vitest-webgl-canvas-mock": "^1.1.0"
	},
	"devDependencies": {
		"@lightningjs/ui-components-theme-base": "^1.2.0",
		"pkgroll": "^2.21.4",
		"semantic-release": "^19.0.5",
		"semantic-release-monorepo": "^7.0.5"
	},
	"dependencies": {
		"@lightningjs/ui-components": "^2.24.0",
		"jest-environment-jsdom": "^30.2.0"
	},
	"scripts": {
		"prepare": "pkgroll",
		"build": "pkgroll",
		"clean": "rimraf ./dist ./tsconfig.tsbuildinfo",
		"wipe": "rimraf ./node_modules"
	}
}
