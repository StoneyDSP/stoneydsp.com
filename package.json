{
	"name": "@stoneydsp/webview-plugin-demo",
	"version": "0.0.4",
	"description": "",
	"keywords": [],
	"type": "module",
	"author": "Nathan Hood <nathan@fxdigital.uk>",
	"license": "UNLICENSED",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		"require": {
			"types": "./dist/index.d.cts",
			"default": "./dist/index.cjs"
		},
		"import": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"imports": {
		"#package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepare": "husky",
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"coverage": "vitest run --coverage",
		"lint": "eslint",
		"format": "prettier",
		"cm": "git-cz",
		"clean": "rimraf dist tsconfig.tsbuildinfo",
		"wipe": "rimraf node_modules",
		"zip": "npm-build-zip --source=./dist --destination=./native/Assets",
		"gen:types": "node ./scripts/vite/generateJuceTypings.mjs"
	},
	"dependencies": {
		"@lightningjs/core": "2.17.0",
		"@lightningjs/sdk": "5.5.5",
		"@vercel/analytics": "^1.6.1",
		"@vercel/functions": "^3.3.4",
		"rxjs": "^7.8.2",
		"stoneydsp": "workspace:*",
		"web-audio-api": "workspace:*"
	},
	"devDependencies": {
		"@commitlint/cli": "19.8.1",
		"@commitlint/config-conventional": "20.3.0",
		"@commitlint/config-pnpm-scopes": "20.1.0",
		"@commitlint/cz-commitlint": "19.8.1",
		"@eslint/css": "^0.14.1",
		"@eslint/js": "^9.39.2",
		"@eslint/json": "^0.14.0",
		"@eslint/markdown": "^7.5.1",
		"@html-eslint/eslint-plugin": "^0.52.1",
		"@stoneydsp/ui-components-vitest-utils": "workspace:*",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/audioworklet": "^0.0.92",
		"@types/juce-framework-frontend": "workspace:*",
		"@types/node": "^25.0.2",
		"@vitest/coverage-v8": "4.0.15",
		"@vitest/ui": "4.0.15",
		"commitizen": "4.3.1",
		"commitlint": "19.8.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-yaml": "^1.1.3",
		"git-cz": "^4.9.0",
		"glob": "^13.0.0",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"jsdom": "^27.3.0",
		"lint-staged": "^16.2.7",
		"npm-build-zip": "^1.0.4",
		"prettier": "^3.7.4",
		"rimraf": "^6.1.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.49.0",
		"vite": "^7.2.7",
		"vitest": "^4.0.15",
		"vitest-webgl-canvas-mock": "^1.1.0"
	},
	"config": {
		"commitizen": {
			"path": "git-cz"
		}
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional",
			"@commitlint/config-pnpm-scopes"
		]
	},
	"packageManager": "pnpm@10.24.0",
	"engines": {
		"node": ">=24.0.0 <25.0.0"
	}
}
