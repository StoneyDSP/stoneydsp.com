{
	"files": [
		"./src/index.ts"
	],
	"include": [
		"./src",
		"**/*.{ts,cts,mts}",
		"**/*.d.{ts,cts,mts}"
	],
	"exclude": [
		"**/*.test.ts"
	],
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"paths": {
			"#package.json": [
				"./package.json"
			]
		},
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"lib": [
			"esnext",
			"DOM",
			"DOM.Iterable",
			"DOM.AsyncIterable"
		],
		"types": [
			"vite/client",
			"vitest/globals"
		],
		"typeRoots": [
			"./types",
			"./packages/@types",
			"./vendors/@types",
			"./node_modules/@types",
			"./node_modules"
		],
		"noEmit": true,
		"allowJs": true,
		"esModuleInterop": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"strict": true,
		"jsx": "preserve",
		"isolatedModules": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"strictNullChecks": true
	}
}
