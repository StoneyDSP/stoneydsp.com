{
	"editor.rulers": [
		80
	],
	"eslint.enable": true,
	"prettier.enable": true,
	"eslint.validate": [
		"javascript",
		"typescript",
		"javascriptreact",
		"typescriptreact",
		"markdown",
		"html",
		"css"
	],
	"typescript.tsdk": "./node_modules/typescript/lib",
	"debug.javascript.terminalOptions": {
		"resolveSourceMapLocations": [
			"${workspaceFolder}/**",
			"!**/node_modules/**",
			"**/node_modules/.vite-temp/**"
		],
		"skipFiles": [
			"<node_internals>/**"
		]
	},
	"C_Cpp.autoAddFileAssociations": true,
	"C_Cpp.default.includePath": [
		"${default}",
		"${env:HOME}/dev/juce-framework/JUCE/modules"
	],
	"files.associations": {}
}
