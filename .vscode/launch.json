{
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Debug Current Test File",
			"autoAttachChildProcesses": true,
			"skipFiles": [
				"<node_internals>/**",
				"**/node_modules/**"
			],
			"program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
			"args": [
				"run",
				"${relativeFile}"
			],
			"smartStep": true,
			"console": "integratedTerminal"
		},
		{
			"type": "node",
			"request": "launch",
			"name": "Run Vitest Browser",
			"program": "${workspaceRoot}/node_modules/vitest/vitest.mjs",
			"console": "integratedTerminal",
			"args": [
				"--inspect-brk",
				"--browser",
				"--no-file-parallelism"
			]
		},
		{
			"type": "chrome",
			"request": "attach",
			"name": "Attach to Vitest Browser",
			"port": 9229
		},
		{
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceRoot}/build/WebviewPluginDemo_artefacts/Standalone/WebView Plugin Demo.app/Contents/MacOS/WebView Plugin Demo",
			"name": "Launch",
			"cwd": "${workspaceRoot}",
			"stopAtEntry": false,
			"linux": {
				"MIMode": "gdb",
				"miDebuggerPath": "/usr/bin/gdb"
			},
			"osx": {
				"MIMode": "lldb",
				"targetArchitecture": "arm64"
			},
			"windows": {
				"MIMode": "gdb",
				"miDebuggerPath": "C:\\MinGw\\bin\\gdb.exe"
			}
		},
		{
			"name": "Reaper",
			"request": "launch",
			"type": "cppdbg",
			"program": "reaper",
			"args": [],
			"osx": {
				"program": "/Applications/REAPER.app/Contents/MacOS/REAPER",
				"MIMode": "lldb",
				"setupCommands": [
					{
						"description": "Enable pretty-printing for gdb",
						"text": "-enable-pretty-printing",
						"ignoreFailures": true
					}
				]
			},
			"stopAtEntry": true,
			"cwd": "${fileDirname}",
			"environment": [],
			"externalConsole": false,
		}
	],
	"compounds": [
		{
			"name": "Debug Vitest Browser",
			"configurations": [
				"Attach to Vitest Browser",
				"Run Vitest Browser"
			],
			"stopAll": true
		}
	]
}
